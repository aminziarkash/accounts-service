meta {
  name: Check: allowed (transfer 100.00)
  type: http
  seq: 1
}

post {
  url: {{limitsUrl}}/api/v1/limits/check
  body: json
  auth: none
}

body:json {
  {
    "accountId": 1,
    "currency": "USD",
    "amount": "100.00",
    "operation": "TRANSFER"
  }
}

tests {
  test("allowed with a 200", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.allowed).to.equal(true);
  });
}
