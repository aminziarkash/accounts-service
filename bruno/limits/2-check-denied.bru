meta {
  name: Check: denied (withdraw 3000.00)
  type: http
  seq: 2
}

post {
  url: {{limitsUrl}}/api/v1/limits/check
  body: json
  auth: none
}

body:json {
  {
    "accountId": 1,
    "currency": "USD",
    "amount": "3000.00",
    "operation": "WITHDRAW"
  }
}

tests {
  test("a denial is still a 200, with a reason", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.allowed).to.equal(false);
    expect(res.body.reason).to.be.a("string");
  });
}
