meta {
  name: Get token (alice)
  type: http
  seq: 1
}

post {
  url: {{keycloakUrl}}/realms/accounts/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: accounts-web
  username: alice
  password: alice
}

script:post-response {
  // runtime variable: kept in memory, never written to a file, so it cannot be committed
  bru.setVar("accessToken", res.body.access_token);
}

tests {
  test("got an access token", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.access_token).to.be.a("string");
  });
}
