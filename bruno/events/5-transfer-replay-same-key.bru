meta {
  name: Transfer replay (fixed key, send twice)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/transfers
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: replay-transfer-1
}

body:json {
  {
    "fromAccountId": {{accountA}},
    "toAccountId": {{accountB}},
    "amount": "1.00"
  }
}

docs {
  Send twice: the same transfer reference comes back and only ONE TRANSFER_COMPLETED event
  is written. Change the key to run it again.
}
