meta {
  name: 2. Transfer, everything healthy
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/transfers
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "fromAccountId": {{accountA}},
    "toAccountId": {{accountB}},
    "amount": "1.00"
  }
}

tests {
  test("transfer went through", function () {
    expect([200, 201]).to.include(res.status);
  });
}
